[credential "https://git.synelixis.com"]
	provider = generic
[core]
	autocrlf = input

[user]
	# Default personal config
	name = emm-n-m
	email = emm.n.black@gmail.com

[core]
	editor = vim
	# Machine-wide hooks, symlinked from this repo by install.sh. Currently
	# commit-msg, which strips Claude Code session links out of commit
	# messages before they reach history. This overrides .git/hooks in every
	# repo; one that needs its own opts out with:
	#   git config core.hooksPath .git/hooks
	hooksPath = ~/.githooks

[init]
	defaultBranch = main

# Automatically use work config for Synelixis GitLab repos
[includeIf "hasconfig:remote.*.url:git@git.synelixis.com:*/**"]
	path = ~/.gitconfig-gitlab-synelixis

[includeIf "hasconfig:remote.*.url:https://git.synelixis.com/**"]
	path = ~/.gitconfig-gitlab-synelixis

[includeIf "hasconfig:remote.*.url:ssh://git@git.synelixis.com/**"]
	path = ~/.gitconfig-gitlab-synelixis

[includeIf "hasconfig:remote.*.url:ssh://git@git.synelixis.com:*/**"]
	path = ~/.gitconfig-gitlab-synelixis

# Automatically use ENDURANCE config for GitLab repos
[includeIf "hasconfig:remote.*.url:git@gitlab.com:*/**"]
        path = ~/.gitconfig-endurance

[includeIf "hasconfig:remote.*.url:https://gitlab.com/**"]
	path = ~/.gitconfig-endurance

[includeIf "hasconfig:remote.*.url:ssh://git@gitlab.com/**"]
	path = ~/.gitconfig-endurance

[includeIf "hasconfig:remote.*.url:ssh://git@gitlab.com:*/**"]
	path = ~/.gitconfig-endurance

# Automatically use XR50 config for Ubitech repos
[includeIf "hasconfig:remote.*.url:git@gitlab.ubitech.eu:*/**"]
        path = ~/.gitconfig-xr50

[includeIf "hasconfig:remote.*.url:https://gitlab.ubitech.eu/**"]
        path = ~/.gitconfig-xr50

[includeIf "hasconfig:remote.*.url:ssh://git@gitlab.ubitech.eu/**"]
        path = ~/.gitconfig-xr50

[includeIf "hasconfig:remote.*.url:ssh://git@gitlab.ubitech.eu:*/**"]
        path = ~/.gitconfig-xr50
[pull]
	rebase = false
