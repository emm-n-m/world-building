[core]
	autocrlf = input

[user]
	# Default personal config
	name = emm-n-m
	email = emm.n.black@gmail.com

[core]
	editor = vim
	# Machine-wide hooks, symlinked from this repo by install.sh. Currently
	# commit-msg, which strips Claude Code session links out of commit
	# messages before they reach history. This overrides .git/hooks in every
	# repo; one that needs its own opts out with:
	#   git config core.hooksPath .git/hooks
	hooksPath = ~/.githooks

[init]
	defaultBranch = main

[pull]
	# Replay local commits on top of the remote instead of recording a merge.
	# Working the same repos from several machines otherwise litters history
	# with "Merge branch 'main' of github.com:..." every time they diverge.
	# Only rewrites commits that have not been pushed yet.
	rebase = true

[rebase]
	# Stash and restore a dirty working tree around the rebase, so a pull with
	# work in progress does not stop and demand a manual stash first.
	autoStash = true

# Work identities, includeIf rules, and employer credential helpers live in
# ~/.gitconfig.local — untracked, present only on work machines (see
# gitconfig.local.example). A missing include file is silently skipped, so
# this is safe on personal-only machines.
[include]
	path = ~/.gitconfig.local
